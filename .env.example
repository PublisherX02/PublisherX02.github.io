# Copy this file to .env and fill in real values. Never commit .env.
ALPACA_API_KEY=your-alpaca-api-key-here
ALPACA_SECRET_KEY=your-alpaca-secret-key-here
ALPACA_PAPER_TRADE=true
# Strongly recommended for competition runs. The agent refuses submissions
# when the authenticated paper account does not match this exact ID.
ALPACA_EXPECTED_ACCOUNT_ID=your-competition-paper-account-id

# Optional: powers the AI commentary panel (src/narration/market_brief.py).
# Without it, the dashboard shows "commentary unavailable" and the rest of
# the system runs unaffected -- this key is never required for trading.
FEATHERLESS_API_KEY=your-featherless-api-key-here
